<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <title>{{ title }}</title>
    <link rel="stylesheet" href="/script/common.css">
    <style>
        .container {
            max-width: 1200px; /* 너비 설정 */
            margin: 0 auto;    /* 좌우 여백 자동(중앙 정렬) */
            background-color: #f9f9f9;
        }
    </style>
    {% block head %}<!-- 자식 페이지의 head 블록 내용 -->{% endblock %}
</head>
<body>
    <div class="container">
        {% block content %}<!-- 개별 페이지의 내용 -->{% endblock %}
    </div>
</body>
</html>