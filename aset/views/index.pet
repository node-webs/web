    <link rel="stylesheet" href="/script/index.css">
    <script src="/script/ssign.js" defer></script>
{% endblock %}

{% block content %}
    <h2>메인 콘텐츠 영역</h2>
    <p>이 영역은 1200px 너비 안에서 가운데 정렬되어 표시됩니다.</p>
{% endblock %}